<Application x:Class="AmongUsModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AmongUsModManager">
    <Application.Resources>
        <!-- Dynamic Dark Themes Palette - Base SteelBlue -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0F141C" />
        <SolidColorBrush x:Key="CardBackground" Color="#161E2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#263449" />
        <SolidColorBrush x:Key="AccentColor" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981" />
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444" />
        <SolidColorBrush x:Key="SubTextColor" Color="#94A3B8" />
        <SolidColorBrush x:Key="InputBackground" Color="#0B111A" />
        <SolidColorBrush x:Key="HeaderBadgeBg" Color="#1E293B" />
        <SolidColorBrush x:Key="HeaderBadgeFg" Color="#93C5FD" />
    </Application.Resources>
</Application>
