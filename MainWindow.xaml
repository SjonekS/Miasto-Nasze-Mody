<Window x:Class="AmongUsModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AmongUsModManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="Among Us Mod Manager v2.0 TEST" 
        Height="700" Width="880"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="#E2E8F0"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D425C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="24,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#252838" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Padding" Value="14,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33374D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dedykowany styl przycisku zamykającego (X) -->
        <Style x:Key="CloseIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#262D3D" />
            <Setter Property="Foreground" Value="#E0E0E6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <TextBlock Text="✕" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       FontSize="{TemplateBinding FontSize}" 
                                       FontWeight="{TemplateBinding FontWeight}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D4558" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ComboBox ToggleButton -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border Background="{DynamicResource InputBackground}" 
                    BorderBrush="{DynamicResource CardBorder}" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Border Background="Transparent" HorizontalAlignment="Right" Width="28">
                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource SubTextColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Border>
        </ControlTemplate>

        <!-- Dark ComboBox Style (Elegancki, ciemny styl bez białych elementów systemu) -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,8,30,8" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource CardBackground}" 
                                            BorderBrush="{DynamicResource CardBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style (Nowoczesny suwak ON/OFF) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#1E293B" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#94A3B8" HorizontalAlignment="Left" Margin="2,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Top Header (Wyższy poziom) -->
            <RowDefinition Height="Auto" /> <!-- 1: Dedykowany Pasek Zakładek -->
            <RowDefinition Height="*" />    <!-- 2: Główny Obszar Zakładek / Nakładek -->
            <RowDefinition Height="Auto" /> <!-- 3: Pasek Postępu Pobierania / Instalacji -->
            <RowDefinition Height="Auto" /> <!-- 4: Pasek Statusu na dole -->
        </Grid.RowDefinitions>

        <!-- 0. Top Level Header: Tytuł i Globalne Narzędzia (Wyższy poziom) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lewa strona: Tytuł aplikacji i oficjalna plakietka wersji v2.0 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Among Us Mod Manager" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border Background="{DynamicResource HeaderBadgeBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="v2.0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HeaderBadgeFg}" />
                </Border>
            </StackPanel>

            <!-- Prawa strona: Narzędzia globalne i Uruchom grę -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙ Ustawienia" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ToggleSettingsCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Ustawienia motywu, pobierania i kopii zapasowych">
                    <Button.Triggers>
                    </Button.Triggers>
                </Button>
                <Button Content="❓ Pomoc" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ToggleTroubleshootCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Procedury naprawcze i zaawansowane czyszczenie" />
                <Button Content="🚀 Uruchom grę Steam" Style="{StaticResource PrimaryButtonStyle}" Padding="18,8" Command="{Binding LaunchGameCommand}" IsEnabled="{Binding IsGamePathValid}" ToolTip="Uruchom grę z oficjalnej instalacji Steam" />
            </StackPanel>
        </Grid>

        <!-- 1. Dedykowany Pasek Zakładek (Osobny wiersz z pełną swobodą szerokości) -->
        <Border Grid.Row="1" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="🎮 Główna Gra (Steam)" Margin="0,0,4,0" Command="{Binding SetTabCommand}" CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Padding" Value="18,8" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource AccentColor}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="📦 Kapsuły / Instancje" Command="{Binding SetTabCommand}" CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Padding" Value="18,8" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource AccentColor}" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2. Główny Obszar Zawartości (Zakładki + Modale) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">

            <!-- SETTINGS OVERLAY -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Nagłówek Ustawień z przyciskiem zamykającym -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Ustawienia Managera" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Button Style="{StaticResource CloseIconButtonStyle}" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Zamknij ustawienia" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <!-- Źródło wydań -->
                        <TextBlock Text="Źródło wydań moda TouMira:" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E6" Margin="0,0,0,4" />
                        <TextBlock Text="GitHub Releases (SjonekS/Miasto-Nasze-Mody)" FontSize="13" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,16" />

                        <!-- Zgrupowane Opcje Kopii Zapasowych (Nad Motywami) -->
                        <TextBlock Text="Zarządzanie kopiami zapasowymi (Backups):" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E6" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AutoBackup}" Content="Twórz automatyczną kopię zapasową (ZIP) przed każdą instalacją (rotacja max 2)" Foreground="#FFFFFF" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Kopie zapasowe w folderze 'backups': " Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BackupsCount}" FontWeight="Bold" Foreground="#FFFFFF" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <Button Content="Otwórz folder kopii" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11" Command="{Binding OpenBackupsFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Wybór Motywu: Czysty Dropdown Menu pod Kopiami (Zgrany Ciemny Styl) -->
                        <TextBlock Text="Motyw kolorystyczny aplikacji:" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E6" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableThemes}" 
                                  SelectedItem="{Binding SelectedTheme}"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  FontSize="13" 
                                  Margin="0,0,0,16">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#334155" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentColor}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding AccentHex}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text=" — " Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SubTextColor}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ToggleSettingsCommand}" />
                        <Button Content="Zapisz ustawienia" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TROUBLESHOOT OVERLAY (POMOC Z SUWAKIEM I ZAATWIERDZANIEM USUWANIU) -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{Binding IsTroubleshootVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Nagłówek Pomocy z przyciskiem zamykającym -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Procedury Naprawcze &amp; Pomoc (Troubleshoot)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Button Style="{StaticResource CloseIconButtonStyle}" Command="{Binding CloseTroubleshootCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Zamknij pomoc" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Bezpieczny Baner informacyjny -->
                            <Border Background="#1C2433" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="Zasada zerowego ryzyka: Program chroni Twoje pliki gry. Zaawansowane procedury usuwania są fabrycznie zablokowane i wymagają aktywacji suwaka poniżej." Foreground="#93C5FD" TextWrapping="Wrap" FontSize="12" />
                            </Border>

                            <!-- Suwak Zezwolenia na Usuwanie Plików -->
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tryb zaawansowanego usuwania plików" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Włącz ten suwak, aby odblokować przyciski usuwania plików modów oraz pełnego resetu plików Among Us." FontSize="11" Foreground="{DynamicResource SubTextColor}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsManualDeletionEnabled}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" ToolTip="Włącz lub wyłącz możliwość usuwania plików" />
                                </Grid>
                            </Border>

                            <!-- Opcja 1: Hard clear samych modów (z zachowaniem BepInEx/config) -->
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="1. Całkowite usunięcie plików modów (Hard Clear)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Usuwa pliki i foldery modów (BepInEx, dotnet, winhttp.dll, doorstop_config.ini). Twój folder z ustawieniami modów (BepInEx/config) oraz czysta gra Among Us zostaną zachowane." FontSize="11" Foreground="{DynamicResource SubTextColor}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Usuń mody (zachowaj config)" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding HardClearModsCommand}" 
                                            IsEnabled="{Binding IsManualDeletionEnabled}" 
                                            Padding="12,8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Opcja 2: Hard clear wszystkich plików Among Us z folderu Steam -->
                            <Border Background="#2A1616" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="2. Pełny reset plików Among Us (Steam)" FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" />
                                        <TextBlock Text="Usuwa wszystkie pliki gry z folderu Steam i instruuje, jak pobrać świeże pliki gry przez Steam. Zanim to nastąpi, zostaniesz zapytany o wykonanie kopii zapasowej." FontSize="11" Foreground="#FDA4AF" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Pełny reset folderu gry" Background="#4C1D1D" Foreground="#FCA5A5" 
                                            Command="{Binding HardClearGameFilesCommand}" 
                                            IsEnabled="{Binding IsManualDeletionEnabled}" 
                                            Padding="12,8" FontWeight="Bold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Opcja 3: Szybkie czyszczenie folderu plugins -->
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="3. Szybkie czyszczenie folderu plugins" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        <TextBlock Text="Usuwa tylko pliki z BepInEx/plugins (wtyczki moda). Ustawienia (config), core BepInEx, czysta gra i kopie zapasowe pozostają nienaruszone. Przydatne przed reinstalacją moda lub przy zmianie wersji." FontSize="11" Foreground="{DynamicResource SubTextColor}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🧹 Wyczyść folder plugins" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding QuickCleanPluginsCommand}"
                                            Padding="12,8" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Opcje Dodatkowe: Kopie Zapasowe i Podgląd Ręczny -->
                            <TextBlock Text="Pozostałe procedury:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Otwórz folder kopii zapasowych" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding OpenBackupsFolderCommand}" />
                                <Button Content="Otwórz folder gry (ręczny podgląd)" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding IsGamePathValid}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Zamknij" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleTroubleshootCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DIAGNOSTIC LOGS OVERLAY -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{Binding IsLogsVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Nagłówek Dziennika z przyciskiem zamykającym -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Dziennik Diagnostyczny" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Button Style="{StaticResource CloseIconButtonStyle}" Command="{Binding CloseLogsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Zamknij dziennik" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" Foreground="#D0D0D5" FontSize="11" FontFamily="Consolas, monospace" Padding="8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Zamknij dziennik" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleLogsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MODAL: TWORZENIE NOWEJ INSTANCJI / KAPSUŁY -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2" CornerRadius="8" Padding="24"
                    Visibility="{Binding IsCreateInstanceDialogVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="25" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <StackPanel>
                    <TextBlock Text="Kreator Nowej Kapsuły Gry Among Us" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <TextBlock Text="Zostanie utworzona pełna, niezależna kopia bieżącej gry i modów ze Steama (kapsuła czasu)." FontSize="12" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,16" />

                    <TextBlock Text="Nazwa kapsuły (np. TouMira_v1.7.3):" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewInstanceName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackground}" Foreground="#FFFFFF" BorderBrush="{DynamicResource CardBorder}" Padding="10,6" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Lokalizacja nadrzędna na dysku:" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewInstanceParentFolder, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBackground}" Foreground="#FFFFFF" BorderBrush="{DynamicResource CardBorder}" Padding="10,6" FontSize="12" />
                        <Button Grid.Column="1" Content="Przeglądaj..." Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" Command="{Binding BrowseNewInstanceParentFolderCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anuluj" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding CloseCreateInstanceDialogCommand}" />
                        <Button Content="Utwórz kapsułę czasu" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCreateInstanceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- ZAKŁADKA 0: GŁÓWNA GRA STEAM (TYLKO DLA INSTALACJI STEAM) -->
            <!-- ======================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Steam Path Card -->
                    <RowDefinition Height="*" />    <!-- Steam Mod Dashboard -->
                </Grid.RowDefinitions>

                <!-- Karta Ścieżki Gry Steam (WIDOCZNA TYLKO W ZAKŁADCE STEAM) -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                    <TextBlock Text="GŁÓWNA GRA (STEAM)" FontWeight="Bold" FontSize="11" Foreground="#60A5FA" />
                                </Border>

                                <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#332B1E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                                    <Setter Property="Background" Value="#1A3326" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Wskaż folder gry" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                                        <Setter Property="Text" Value="Poprawna instalacja" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding GamePath, TargetNullValue='Nie wybrano folderu gry'}" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GamePathStatus}" FontSize="11" Foreground="{DynamicResource SubTextColor}" FontStyle="Italic" Margin="0,0,10,0" />
                                <Border Background="#252838" CornerRadius="3" Padding="4,1" Visibility="{Binding IsGamePathValid, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding GameVersionDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Wykryj Steam" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding AutoDetectSteamCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Automatycznie wyszukaj grę w bibliotekach Steam" />
                            <Button Content="Zmień..." Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Command="{Binding BrowseGamePathCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Wskaż ręcznie folder zawierający Among Us.exe" />
                            <Button Content="Otwórz folder" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding IsGamePathValid}" ToolTip="Otwórz folder gry w Eksploratorze Windows" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dashboard Modów TouMira dla Steam -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title & Header -->
                        <TextBlock Grid.Row="0" Text="Zarządzanie Modyfikacją TouMira (Wersja Steam)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />

                        <!-- Version Status Cards Row -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Installed Version Box -->
                            <Border Grid.Column="0" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Zainstalowana wersja na Steam:" FontSize="12" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding InstalledVersion}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding InstalledDetails}" FontSize="11" Foreground="{DynamicResource SubTextColor}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Latest Remote Version Box -->
                            <Border Grid.Column="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Najnowsza dostępna wersja:" FontSize="12" Foreground="{DynamicResource SubTextColor}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LatestRemoteVersion}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,4" />
                                    <TextBlock Text="Serwer wydań GitHub (SjonekS/Miasto-Nasze-Mody)" FontSize="11" Foreground="{DynamicResource SubTextColor}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status Banner -->
                        <Border Grid.Row="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningColor}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding MainStatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Primary Action Buttons Row -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Pobierz i zainstaluj na Steam" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DownloadAndInstallCommand}" IsEnabled="{Binding IsNotBusy}" />
                            <Button Grid.Column="2" Content="Wybierz ZIP ręcznie" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectManualZipCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Zainstaluj pobrany wcześniej plik ZIP z dysku do gry Steam" />
                            <Button Grid.Column="4" Content="Sprawdź wersję" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsNotBusy}" ToolTip="Odśwież informację o najnowszej wersji na GitHub" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- ZAKŁADKA 1: DEDYKOWANA STRONA INSTANCJI / KAPSUŁ CZASU   -->
            <!-- (BRAK PASKÓW STEAM, PEŁNE NIEZALEŻNE ZARZĄDZANIE)       -->
            <!-- ======================================================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Nagłówek zakładki instancji (zabezpieczony przed nachodzeniem na przyciski) -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Kapsuły Czasu Among Us (Niezależne Instancje)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Każda kapsuła to zamrożona kopia gry i modów. Możesz uruchamiać i modyfikować każdą kapsułę niezależnie bez dotykania Steama." FontSize="12" Foreground="{DynamicResource SubTextColor}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Odśwież listę" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding RefreshInstancesCommand}" />
                            <Button Content="+ Utwórz nową kapsułę" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ShowCreateInstanceDialogCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Responsywna Siatka Instancji (WrapPanel - automatyczne kolumny na pełnym ekranie) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,16" Width="380" MinHeight="190">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Nagłówek kafelka kapsuły z plakietkami wersji -->
                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <!-- Badge Wersji Gry Among Us -->
                                                    <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayGameVersion}" FontSize="10" Foreground="#93C5FD" FontWeight="SemiBold" />
                                                    </Border>
                                                    <!-- Badge Wersji Modyfikacji -->
                                                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayVersion}" FontSize="10" Foreground="#6EE7B7" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Szczegóły ścieżki i statusu kapsuły -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SubTextColor}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip="{Binding Path}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#CBD5E1" FontStyle="Italic" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Utworzono: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{DynamicResource SubTextColor}" />
                                            </StackPanel>

                                            <!-- Niezależne Przyciski Akcji Bezpośrednio na Kapsule -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Uruchom kapsułę natychmiast -->
                                                <Button Grid.Column="0" Content="🚀 Uruchom" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.LaunchInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Uruchom grę bezpośrednio z tej niezależnej kapsuły" />

                                                <!-- Zaktualizuj mod w kapsule -->
                                                <Button Grid.Column="1" Content="⚡ Aktualizuj mod" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.UpdateInstanceModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Pobierz i zainstaluj najnowszą wersję TouMira do tej kapsuły" />

                                                <!-- Zainstaluj ZIP w kapsule -->
                                                <Button Grid.Column="2" Content="📦 ZIP..." Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.InstallZipToInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Zainstaluj plik ZIP z dysku bezpośrednio do tej kapsuły" />

                                                <!-- Otwórz folder -->
                                                <Button Grid.Column="3" Content="📁" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Otwórz folder tej kapsuły w Eksploratorze" />

                                                <!-- Usuń -->
                                                <Button Grid.Column="4" Content="🗑" Background="#3F1717" Foreground="#FCA5A5" Padding="8,6" FontSize="11"
                                                        Command="{Binding DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Bezpiecznie usuń tę kapsułę" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Pasek Postępu Pobierania / Instalacji -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ProgressTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressDetail}" FontSize="12" Foreground="{DynamicResource SubTextColor}" FontWeight="SemiBold" />
                </Grid>

                <ProgressBar Height="8" Minimum="0" Maximum="100" 
                             Value="{Binding ProgressPercentage}" 
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Foreground="{DynamicResource AccentColor}" 
                             Background="{DynamicResource InputBackground}" 
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- 4. Dolny Pasek Informacyjny & Visual Guide (Przewodnik Krok po Kroku) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Visual Guide (Pasek Przewodnika Krok po Kroku) -->
            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Przycisk Poprzedni Krok -->
                    <Button Content="◀" Command="{Binding PreviousGuideStepCommand}" Background="Transparent" Foreground="{DynamicResource SubTextColor}" BorderThickness="0" Padding="6,2" Cursor="Hand" ToolTip="Poprzednia wskazówka" VerticalAlignment="Center" />

                    <!-- Treść Kroków Przewodnika -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Border Background="{DynamicResource AccentColor}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GuideStepDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock Text="{Binding GuideTitle}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="—" Foreground="{DynamicResource SubTextColor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding GuideDescription}" FontSize="11" Foreground="{DynamicResource SubTextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Przycisk Następny Krok -->
                    <Button Grid.Column="2" Content="▶" Command="{Binding NextGuideStepCommand}" Background="Transparent" Foreground="{DynamicResource SubTextColor}" BorderThickness="0" Padding="6,2" Cursor="Hand" ToolTip="Następna wskazówka" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Przycisk Dziennika Diagnostycznego -->
            <Button Grid.Column="1" Content="Dziennik diagnostyczny" Background="Transparent" Foreground="{DynamicResource SubTextColor}" FontSize="11" Padding="6,2" Cursor="Hand" Command="{Binding ToggleLogsCommand}" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextDecorations="Underline" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
